<Window x:Class="OpenCmd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OpenCmd.Converters"
        Title="{Binding WindowTitle}"
        Icon="Assets/OpenCmd.ico"
        Height="860"
        Width="840"
        MinHeight="560"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#101114"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Language="es"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6EE7B7"/>
            <Setter Property="Foreground" Value="#06281C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8EF0C8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4ADE80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5CDD8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2C3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                                <Setter Property="Foreground" Value="#F2F4F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C212B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="RecentOpenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ShellChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C5CDD8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1C212B" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="8" Padding="12,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14352C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#3A4252" BorderThickness="1.5" Background="Transparent">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#06281C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6EE7B7"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6EE7B7"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandBox" TargetType="TextBox">
            <Setter Property="Background" Value="#101114"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#2C3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#F2F4F8"/>
            <Setter Property="SelectionBrush" Value="#1F6B4A"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RecentCard">
            <Border Background="#181B22" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#6EE7B7" FontSize="12" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FullPath}" Foreground="#6E7787" FontSize="11" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cursor" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" Margin="0,0,8,0" Click="RecentCursor_Click"
                            ToolTip="Abrir este proyecto en Cursor"/>
                    <Button Grid.Column="2" Content="Editar" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" Margin="0,0,8,0" Click="RecentEdit_Click"/>
                    <Button Grid.Column="3" Content="Abrir" Style="{StaticResource RecentOpenButton}"
                            VerticalAlignment="Center" Click="RecentOpen_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="#14352C" Margin="0,0,12,0">
                    <TextBlock Text="&gt;_" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Bold"
                               Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Open CMD" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="PowerShell dividida para cada proyecto" Foreground="#9AA3B5" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="36" Height="36"
                        VerticalAlignment="Center" Click="Home_Click" ToolTip="Volver al inicio"
                        AutomationProperties.Name="Inicio"
                        Visibility="{Binding HasRoot, Converter={StaticResource BoolVis}}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Foreground="#F2F4F8"/>
                </Button>
            </Grid>
            <TextBlock Text="Seleccioná la carpeta padre. Se abre en Windows Terminal, con un panel por cada parte del proyecto."
                       TextWrapping="Wrap" Foreground="#C5CDD8" Margin="0,14,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0" Height="168"
              Visibility="{Binding HasRoot, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#2C3340" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#14181F"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Soltá la carpeta acá" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="o elegila con el botón" Foreground="#9AA3B5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Button Content="Elegir carpeta" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        HorizontalAlignment="Center" Click="ChooseFolder_Click" Padding="18,10"/>
                <TextBlock Text="Ctrl+O" Foreground="#6E7787" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Background="#181B22" BorderBrush="#2C3340" BorderThickness="1"
                CornerRadius="14" Padding="16,14"
                Visibility="{Binding HasRoot, Converter={StaticResource BoolVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abrir en Cursor" Style="{StaticResource GhostButton}" Click="OpenRootInCursor_Click" Margin="0,0,8,0"/>
                    <Button Content="Volver a leer" Style="{StaticResource GhostButton}" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="Cambiar" Style="{StaticResource GhostButton}" Click="ChooseFolder_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RootName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RootPath}" FontSize="12" Foreground="#8B93A7"
                               TextTrimming="CharacterEllipsis" Margin="0,3,16,0" ToolTip="{Binding RootPath}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="2,16,0,8"
                    Visibility="{Binding HasRoot, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ProjectsHeading}" Foreground="#9AA3B5"/>
            <TextBlock Text="No detecté proyectos por sus archivos. Marcá las carpetas que quieras abrir."
                       TextWrapping="Wrap" Foreground="#C5CDD8" Margin="0,6,0,0"
                       Visibility="{Binding ShowFallback, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowProjects, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#181B22" BorderBrush="#2C3340" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Top" Margin="0,4,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Cursor" Style="{StaticResource GhostButton}"
                                                Click="OpenChildInCursor_Click" ToolTip="Abrir esta carpeta en Cursor"
                                                VerticalAlignment="Center" Margin="8,0,0,0" Padding="10,4"/>
                                        <Border DockPanel.Dock="Right" Background="#21262F" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#9AA3B5"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="ToggleProject_Click"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding FullPath}" FontSize="12" Foreground="#6E7787" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBox Text="{Binding StartCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource CommandBox}"
                                                 ToolTip="Se ejecuta al abrir. Si queda vacío, solo se abre la consola."/>
                                        <TextBlock Text="{Binding CommandPlaceholder}" IsHitTestVisible="False"
                                                   Margin="12,0,12,0" VerticalAlignment="Center" Foreground="#6E7787"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StartCommand}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <Button Content="↑" Style="{StaticResource IconButton}" Click="MoveUp_Click" ToolTip="Mover antes"/>
                                    <Button Content="↓" Style="{StaticResource IconButton}" Click="MoveDown_Click" Margin="0,4,0,0" ToolTip="Mover después"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="Esta carpeta no tiene subcarpetas." Foreground="#9AA3B5" Margin="2,4,0,0"
                   Visibility="{Binding ShowEmptyFolder, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer Grid.Row="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowRecentHome, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="Últimos proyectos" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Se guardan los últimos 3. Abrir vuelve a lanzar la terminal."
                           Foreground="#9AA3B5" Margin="0,4,0,12"/>
                <ItemsControl ItemsSource="{Binding Recents}" ItemTemplate="{StaticResource RecentCard}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0,8,0,0"
                    Visibility="{Binding HasRoot, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Consola" Foreground="#9AA3B5" Margin="2,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Shells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Shell" Content="{Binding Label}" Style="{StaticResource ShellChip}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Shell_Checked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Margin="2,12,0,10" Foreground="#C5CDD8" TextWrapping="Wrap"/>
            <Button Content="{Binding OpenLabel}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanOpen}" Click="Open_Click"/>
            <TextBlock Text="Si dejás un comando, se ejecuta al abrir. Si lo dejás vacío, solo queda la consola en esa carpeta."
                       Margin="2,8,0,0" Foreground="#6E7787" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
